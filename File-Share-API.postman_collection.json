{
  "info": {
    "_postman_id": "file-share-api-collection",
    "name": "File Share API - MNO & API Key Authentication",
    "description": "Complete API for File Share with MNO management and API key authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{BASE_URL}}/health",
          "host": ["{{BASE_URL}}"],
          "path": ["health"]
        },
        "description": "Verify the API server is running"
      },
      "response": []
    },
    {
      "name": "Admin: MNO Management",
      "item": [
        {
          "name": "Create MNO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Airtel\",\n  \"description\": \"Airtel Zambia Ltd\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/mnos",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "mnos"]
            },
            "description": "Create a new Mobile Network Operator (MNO)\n\nReturns: mnoId (save this and share with MNO admin)"
          },
          "response": []
        },
        {
          "name": "Get All MNOs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/mnos",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "mnos"]
            },
            "description": "List all registered MNOs"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Admin: Generate API Key",
      "item": [
        {
          "name": "Generate API Key for MNO + Country",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mnoId\": {{MNO_ID}},\n  \"country\": \"{{COUNTRY}}\"\n}"
            },
            "url": {
              "raw": "{{BASE_URL}}/api/api-keys",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "api-keys"]
            },
            "description": "Generate API key for MNO + Country (Admin only)\n\nFlow:\n1. Admin creates MNO (POST /api/mnos)\n2. Admin generates API key for MNO + Country using this endpoint\n3. Admin shares the accessKey with clients\n\nParameters:\n- mnoId: MNO ID (from Create MNO response)\n- country: Country (Kenya, South Sudan, Tanzania, UAE, Liberia, Zambia, DRC, Rwanda, Uganda)\n\nReturns: accessKey to be shared with clients"
          },
          "response": []
        },
        {
          "name": "Get All API Keys",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/api-keys",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "api-keys"]
            },
            "description": "List all generated API keys (Admin use)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Client: File Operations",
      "item": [
        {
          "name": "Upload File",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "description": "File to upload",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "accessKey",
                  "value": "{{API_KEY}}",
                  "description": "Access key from Generate API Key response (e.g., sk_mtn_zambia_...)",
                  "type": "text"
                }
              ]
            },
            "url": {
              "raw": "{{BASE_URL}}/api/files/upload",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "files", "upload"]
            },
            "description": "Upload a file\n\nFlow:\n1. Receive API key from admin\n2. Upload file with the API key in form data\n3. File is automatically linked to MNO + country from the API key"
          },
          "response": []
        },
        {
          "name": "List Files",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/files?accessKey={{API_KEY}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "files"],
              "query": [
                {
                  "key": "accessKey",
                  "value": "{{API_KEY}}"
                }
              ]
            },
            "description": "Get all files for your MNO + country\n\nPass your access key as query parameter\nReturns: only files that belong to your MNO and country\n\nResponse includes: fileId, originalName, fileSize, mimeType, country, uploadedDate"
          },
          "response": []
        },
        {
          "name": "Download File",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/files/{{FILE_ID}}?accessKey={{API_KEY}}",
              "host": ["{{BASE_URL}}"],
              "path": ["api", "files", "{{FILE_ID}}"],
              "query": [
                {
                  "key": "accessKey",
                  "value": "{{API_KEY}}"
                }
              ]
            },
            "description": "Get file metadata by ID\n\nFlow:\n1. List files to get the fileId\n2. Use fileId to retrieve metadata\n3. Returns: file metadata if it belongs to your MNO + country\n\nRequired:\n- FILE_ID: from List Files response\n- accessKey: your access key"
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "BASE_URL",
      "value": "http://localhost:3000/server/file_management_function",
      "type": "string",
      "description": "Local development URL"
    },
    {
      "key": "PROD_URL",
      "value": "https://secure-data-bridge-942310354.development.catalystserverless.com/server/file_management_function",
      "type": "string",
      "description": "Production URL"
    },
    {
      "key": "MNO_ID",
      "value": "",
      "type": "string",
      "description": "Your MNO ID (from admin)"
    },
    {
      "key": "COUNTRY",
      "value": "Zambia",
      "type": "string",
      "description": "Country: Kenya, South Sudan, Tanzania, UAE, Liberia, Zambia, DRC, Rwanda, Uganda"
    },
    {
      "key": "API_KEY",
      "value": "",
      "type": "string",
      "description": "Your API key - use the 'accessKey' value from the Generate API Key response (e.g., sk_mtn_zambia_..."
    },
    {
      "key": "FILE_ID",
      "value": "",
      "type": "string",
      "description": "File ID from List Files response"
    }
  ]
}
